@startuml flujo

start

if (¿Se pudo cargar el nivel?) then (sí)
    :Controller carga TABLERO;
    :Controller agrega pasajeros a Queue;
    :Controller agrega buses a Traffic;
else (no)
    :Console muestra el error de carga;
    stop
endif

while (¿quedan buses en Traffic?) is (sí)
    :Console imprime matriz con IDs y flechas de dirección;
    :Usuario ingresa ID o "salir";

    if (¿es "salir" o entrada vacía?) then (sí)
        stop
    else (no)
        :Controller convierte la entrada a ID;
        if (¿ID válido y bus existente?) then (sí)
            if (¿bus puede salir y Parking tiene espacio?) then (sí)
                :Traffic quita el bus y libera sus celdas;
                :Parking recibe el bus;
                :Console confirma la salida;
            else (no)
                :Console muestra error;
            endif
        else (no)
            :Console muestra error;
        endif
    endif
endwhile (no)

:Console muestra victoria;
stop

@enduml