@startuml secuencia

actor Usuario
participant Main
participant Console
participant Controller
participant Traffic
participant Parking
participant Queue

Main -> Controller : loadLevel(path)
Controller -> Queue : clear()
Controller -> Traffic : initializeBoard(width, height)
loop por cada linea de PASAJEROS
    Controller -> Queue : add(Passager(color, cantidad))
end
loop por cada linea de BUSES
    Controller -> Traffic : addBus(bus)
    Traffic --> Controller : agregado / error de ubicacion
end
Controller --> Main : nivel cargado

loop mientras haya buses y el usuario no salga
    Main -> Console : printBoard(Traffic)
    Console -> Traffic : getGrid(), getBuses()
    Traffic --> Console : matriz e IDs/direcciones
    Console -> Usuario : muestra matriz con flechas
    Main -> Console : readCommand()
    Usuario -> Console : ID o "salir"
    Console --> Main : comando

    alt comando es "salir" o esta vacio
        Main -> Main : termina el bucle
    else se procesa un ID
        Main -> Controller : processCommand(comando)
        Controller -> Traffic : getBus(id)
        Traffic --> Controller : bus / null

        alt ID invalido o bus inexistente
            Controller --> Main : false
            Main -> Console : printError(...)
        else bus existe
            Controller -> Parking : isFull()
            alt estacionamiento lleno
                Parking --> Controller : true
                Controller --> Main : false
                Main -> Console : printError(...)
            else hay espacio
                Parking --> Controller : false
                Controller -> Traffic : canExit(bus)
                Traffic --> Controller : libre / bloqueado

                alt camino libre
                    Controller -> Traffic : removeBus(id)
                    Traffic --> Controller : bus retirado
                    Controller -> Parking : receiveBus(bus)
                    Controller --> Main : true
                    Main -> Console : printMessage("Bus enviado...")
                else bloqueado
                    Controller --> Main : false
                    Main -> Console : printError(...)
                end
            end
        end
    end
end

opt no quedan buses en Traffic
    Main -> Console : printWin()
    Console -> Usuario : "Ganaste."
end

@enduml