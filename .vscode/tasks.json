                "Vista/Scenery.cpp",
                "Vista/SceneryWindow.cpp",
                "Controlador/Controller.cpp",
                "Modelo/Bus.cpp",
                "Modelo/Parking.cpp",
                "Modelo/Passager.cpp",
                "Modelo/Queue.cpp",
                "Modelo/Traffic.cpp",
                "Modelo/WaitingRoom.cpp",
                "-I${workspaceFolder}",
                "-IC:\\allegro5\\include",
                "-LC:\\allegro5\\lib",
